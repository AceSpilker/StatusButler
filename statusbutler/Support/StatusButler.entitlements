<?xml version="1.0" encoding="UTF-8"?>
<!--
  StatusButler iCloud entitlements 模板（T-219 / E8）
  容器配置用户清单（容器创建本身属外部动作，见 docs/c2-plan.html 外部依赖清单）：
  1. Apple Developer 后台创建容器 iCloud.com.linzhongyang.statusbutler
     （与 CloudKitStore.containerIdentifier 单点对齐，改名 = 换同步域）；
  2. CloudKit Console 建 record type "SettingsSnapshot"（CloudKitStore.recordType），
     字段：settingsJSON(Data) / themeJSON(Data) / modified(Date) / deviceName(String)；
  3. 打包签名（Developer ID + 公证）时把本文件作为 codesign --entitlements 输入
     （swift run 裸跑不带签名，iCloud 开关此时应显示"未配置 iCloud 权限"降级文案）。
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.linzhongyang.statusbutler</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
